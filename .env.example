# Polymarket CLOB API credentials (generate at https://polymarket.com Settings -> API)
POLY_API_KEY=your_api_key_here
POLY_API_SECRET=your_api_secret_here
POLY_API_PASSPHRASE=your_passphrase_here

# Polymarket proxy/Safe wallet address (this is the address that holds your CLOB
# positions, NOT your EOA — find it in the Polymarket UI under Settings -> API)
POLY_PROXY_ADDRESS=0xyour_proxy_wallet_address_here

# Signature type: 1 = POLY_PROXY (default for UI-created accounts), 2 = POLY_GNOSIS_SAFE
POLY_SIGNATURE_TYPE=1

# Your wallet private key — used to sign orders. NEVER commit this.
POLY_PRIVATE_KEY=0xyour_private_key_here

# Polygon RPC endpoint (Alchemy or Infura recommended)
POLYGON_RPC_URL=https://polygon-mainnet.g.alchemy.com/v2/your_alchemy_key

# Paper trading mode — set to "true" to simulate fills without sending real orders
PAPER_TRADING=true

# Optional: sponsored Chainlink API key for Polymarket RTDS. Required only if you
# want the priority/SLA Chainlink stream. The free stream works without this.
# Request a key at https://pm-ds-request.streams.chain.link/
CHAINLINK_RTDS_API_KEY=
